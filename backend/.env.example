PORT=5000
NODE_ENV=development

TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

JWT_ACCESS_SECRET=replace_with_64_char_random_string
JWT_REFRESH_SECRET=replace_with_64_char_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS — comma-separated list for multiple origins (e.g. Vercel preview + production)
FRONTEND_URL=http://localhost:5173

# RAMS integration (/api/integration) — the bearer token RAMS sends. Optional:
# leave it unset and every integration call answers 503. Use a long random
# string, different per environment, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_TOKEN=
